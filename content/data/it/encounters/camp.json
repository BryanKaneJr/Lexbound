        { "concept": "friend", "type": "gesture", "how": "He hugs your leg and won't let go." }
      ]
    },
    "scene": {
      "background": "camp",
      "props": [
        { "id": "log", "art": "log", "x": 0.2, "y": 0.93, "scale": 0.8 },
