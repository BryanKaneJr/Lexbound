      { "type": "say", "line": "milo.attacco", "anim": "stomp", "mood": "fierce", "look": "log" },
      { "type": "act", "actor": "milo", "anim": "cast", "mood": "excited", "text": "Now he's himself again, flinging his paws out wide like he's throwing a wave." },
      { "type": "say", "line": "milo.acqua.acqua", "anim": "splash", "mood": "excited" },
      { "type": "act", "actor": "milo", "anim": "slump", "mood": "tired", "text": "Then he flops onto his back: a very soggy Emberhog." },
      { "type": "act", "actor": "milo", "anim": "hop", "mood": "proud", "text": "He springs up and points at you." },
      { "type": "say", "line": "milo.bravo", "anim": "clap", "mood": "proud" },
      {
        "type": "choice",
        "options": [
          { "label": "Laugh", "goto": "done", "effects": { "bond": 2 } },
          { "label": "Clap back", "goto": "done", "effects": { "bond": 2 } }
        ]
      },
      { "id": "done", "type": "say", "line": "milo.amico", "anim": "hug", "mood": "happy" },
      { "type": "reward", "effects": { "flags": ["camp.retell.done"], "journal": ["milo.retell"] } },
      { "type": "end" }
    ]
  }
]
