      {"type": "say", "line": "milo.ha_fame", "anim": "point", "mood": "excited", "look": "pebblit"},
      {
        "id": "give",
        "type": "give",
        "to": "pebblit",
        "items": [
          {"item": "sunberries", "goto": "share", "evidence": [{"concept": "hungry", "result": "success"}]},
          {"item": "flask", "goto": "flask", "evidence": [{"concept": "hungry", "result": "fail"}]},
          {"item": "stick", "goto": "stick", "evidence": [{"concept": "hungry", "result": "fail"}]}
        ]
      },
      {"id": "flask", "type": "act", "actor": "pebblit", "anim": "tilt", "mood": "confused", "text": "The Pebblit sniffs the flask, then looks back up at the berries."},
      {"type": "say", "line": "pebblit.ho_fame", "anim": "droop", "mood": "sad", "look": "bush", "next": "give"},
