[
  {
    "id": "ww.first_steps",
    "location": "whisperwood",
    "title": "Something in the bushes",
    "kind": "story",
    "order": 3,
    "teaching": {
      "purpose": "Milo's first look at Whisperwood: he spots something hidden and wants you to see it, then can't wait to explore further.",
      "introduces": ["look", "come", "here"],
      "grounding": [
        {"concept": "look", "type": "gesture", "how": "Milo points at the bush, eyes wide, and won't look away from it."},
        {"concept": "come", "type": "gesture", "how": "Milo runs ahead, beckons with his paw and waits for you."},
        {"concept": "here", "type": "gesture", "how": "He trots back and waves you over to exactly where he's standing."}
      ]
    },
    "scene": {
      "background": "forest_path",
      "props": [
        {"id": "log", "art": "log", "x": 0.18, "y": 0.92, "scale": 0.9},
        {"id": "bush", "art": "bush", "x": 0.76, "y": 0.86},
        {"id": "stone", "art": "shiny_stone", "x": 0.7, "y": 0.9, "hidden": true},
        {"id": "mushroom", "art": "mushroom", "x": 0.5, "y": 0.93, "scale": 0.8}
      ],
      "actors": [
        {"id": "milo", "art": "milo", "x": 0.34, "y": 0.86, "mood": "happy"}
      ]
    },
    "steps": [
      {"type": "narrate", "text": "Whisperwood. Tall trees, soft moss, and a hundred small sounds you can't place."},
      {"type": "act", "actor": "milo", "anim": "sniff", "mood": "curious", "text": "Milo's ears swivel. He freezes."},
      {"type": "say", "line": "milo.guarda", "anim": "point", "mood": "excited", "look": "bush"},
      {
        "id": "look",
        "type": "tap",
        "targets": [
          {"prop": "bush", "goto": "found", "evidence": [{"concept": "look", "result": "success"}]}
        ],
        "otherwise": {"goto": "again"}
      },
      {"id": "again", "type": "say", "line": "milo.guarda", "anim": "point", "mood": "annoyed", "look": "bush", "next": "look"},
      {"id": "found", "type": "act", "actor": "bush", "anim": "shake", "text": "You part the leaves."},
      {"type": "stage", "show": ["stone"]},
      {"type": "narrate", "text": "Behind the bush: a smooth stone that shimmers faintly. When Milo leans close, it glows a little brighter."},
      {"type": "act", "actor": "milo", "anim": "bounce", "mood": "excited", "look": "stone", "text": "Milo is thrilled. You pocket it for him."},
      {"type": "reward", "effects": {"items": {"shiny_stone": 1}}},
      {"type": "stage", "hide": ["stone"], "move": [{"id": "milo", "x": 0.82}]},
      {"type": "say", "line": "milo.vieni", "anim": "beckon", "mood": "happy"},
      {
        "id": "choose",
        "type": "choice",
        "options": [
          {"label": "Follow Milo", "goto": "follow", "evidence": [{"concept": "come", "result": "success"}]},
          {"label": "Stay put", "goto": "stay"}
        ]
      },
      {"id": "stay", "type": "act", "actor": "milo", "anim": "tug", "mood": "annoyed", "text": "Milo trots back, grabs your sleeve and tugs."},
      {"type": "say", "line": "milo.vieni.qui", "anim": "beckon", "mood": "happy"},
      {
        "type": "choice",
        "options": [
          {"label": "Follow Milo", "goto": "follow", "evidence": [{"concept": "come", "result": "success"}]}
        ]
      },
      {"id": "follow", "type": "narrate", "text": "You follow Milo deeper into the trees, toward the sound of running water."},
      {"type": "reward", "effects": {"bond": 1, "flags": ["ww.first_steps.done"], "journal": ["story.whisperwood", "places.whisperwood"]}},
      {"type": "end"}
    ]
  },
  {
    "id": "ww.stream",
    "location": "whisperwood",
    "title": "The stream",
    "kind": "story",
    "order": 4,
    "teaching": {
      "purpose": "The first stream: Milo is overjoyed, and it's a moment to play together.",
      "introduces": ["water"],
      "grounding": [
        {"concept": "water", "type": "environment", "how": "Milo laps at the stream, slaps it with both paws and points right at it."}
      ]
    },
    "scene": {
      "background": "forest_stream",
      "props": [
        {"id": "stream", "art": "ripple", "x": 0.5, "y": 0.8}
      ],
      "actors": [
        {"id": "milo", "art": "milo", "x": 0.26, "y": 0.9, "mood": "happy"}
      ]
    },
    "steps": [
      {"type": "narrate", "text": "The trees open onto a bright, chattering stream."},
      {"type": "act", "actor": "milo", "anim": "run", "mood": "excited", "text": "Milo races to the water's edge."},
      {"type": "stage", "move": [{"id": "milo", "x": 0.5, "y": 0.86}]},
      {"type": "act", "actor": "milo", "anim": "drink", "mood": "happy", "look": "stream", "text": "He laps at the water, then slaps it with both paws."},
      {"type": "say", "line": "milo.acqua", "anim": "point", "mood": "excited", "look": "stream"},
      {
        "id": "what",
        "type": "choice",
        "options": [
          {"label": "Splash Milo", "goto": "splash", "effects": {"bond": 2}},
          {"label": "Drink from the stream", "goto": "drink", "effects": {"bond": 1}},
          {"label": "Keep walking", "goto": "walk"}
        ]
      },
      {"id": "splash", "type": "act", "actor": "milo", "anim": "shake", "mood": "surprised", "text": "Milo sputters, shakes himself off, and splashes you right back."},
      {"type": "say", "line": "milo.acqua.acqua", "anim": "splash", "mood": "excited", "next": "out"},
      {"id": "drink", "type": "act", "actor": "milo", "anim": "drink", "mood": "happy", "text": "You cup your hands and drink. It's cold and sweet. Milo copies you, slurping loudly."},
      {"type": "say", "line": "milo.acqua.acqua", "anim": "bounce", "mood": "excited", "next": "out"},
      {"id": "walk", "type": "act", "actor": "milo", "anim": "droop", "mood": "sad", "text": "Milo looks at the stream. Then at you. He isn't done with it."},
      {"type": "say", "line": "milo.acqua", "anim": "point", "mood": "sad", "look": "stream"},
      {
        "type": "choice",
        "options": [
          {"label": "Splash Milo", "goto": "splash", "effects": {"bond": 2}},
          {"label": "Let him play", "goto": "play", "effects": {"bond": 1}}
        ]
      },
      {"id": "play", "type": "act", "actor": "milo", "anim": "splash", "mood": "excited", "text": "Milo kicks happily through the shallows."},
      {"type": "say", "line": "milo.acqua.acqua", "anim": "splash", "mood": "excited"},
      {"id": "out", "type": "narrate", "text": "Eventually Milo climbs out, dripping and very pleased with himself."},
      {"type": "reward", "effects": {"flags": ["ww.stream.done"]}},
      {"type": "end"}
    ]
  },
  {
